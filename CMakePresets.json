{
  "version": 6,
  "configurePresets": [
    {
      "name": "Base-gcc",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "gcc-16",
        "CMAKE_CXX_COMPILER": "g++-16"
      }
    },
    {
      "name": "Base-clang",
      "hidden": true,
      "cacheVariables": {
        "CMAKE_C_COMPILER": "clang-23",
        "CMAKE_CXX_COMPILER": "clang++-23"
      }
    },
    {
      "name": "Base-Debug",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Debug"
      }
    },
    {
      "name": "Base-Release",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "Release"
      }
    },
    {
      "name": "Base-RelWithDebInfo",
      "hidden": true,
      "generator": "Ninja",
      "cacheVariables": {
        "CMAKE_BUILD_TYPE": "RelWithDebInfo"
      }
    },
    {
      "name": "gcc-Debug",
      "inherits": [
        "Base-gcc",
        "Base-Debug"
      ],
      "binaryDir": "${sourceDir}/build/gcc/Debug"
    },
    {
      "name": "gcc-Release",
      "inherits": [
        "Base-gcc",
        "Base-Release"
      ],
      "binaryDir": "${sourceDir}/build/gcc/Release"
    },
    {
      "name": "gcc-RelWithDebInfo",
      "inherits": [
        "Base-gcc",
        "Base-RelWithDebInfo"
      ],
      "binaryDir": "${sourceDir}/build/gcc/RelWithDebInfo"
    },
    {
      "name": "clang-Debug",
      "inherits": [
        "Base-clang",
        "Base-Debug"
      ],
      "binaryDir": "${sourceDir}/build/clang/Debug"
    },
    {
      "name": "clang-Release",
      "inherits": [
        "Base-clang",
        "Base-Release"
      ],
      "binaryDir": "${sourceDir}/build/clang/Release"
    },
    {
      "name": "clang-RelWithDebInfo",
      "inherits": [
        "Base-clang",
        "Base-RelWithDebInfo"
      ],
      "binaryDir": "${sourceDir}/build/clang/RelWithDebInfo"
    }
  ],
  "buildPresets": [
    {
      "name": "gcc-Debug",
      "configurePreset": "gcc-Debug"
    },
    {
      "name": "gcc-Release",
      "configurePreset": "gcc-Release"
    },
    {
      "name": "gcc-RelWithDebInfo",
      "configurePreset": "gcc-RelWithDebInfo"
    },
    {
      "name": "clang-Debug",
      "configurePreset": "clang-Debug"
    },
    {
      "name": "clang-Release",
      "configurePreset": "clang-Release"
    },
    {
      "name": "clang-RelWithDebInfo",
      "configurePreset": "clang-RelWithDebInfo"
    }
  ]
}