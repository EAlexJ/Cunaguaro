diff --git a/benchmarks/Makefile b/benchmarks/Makefile
index 8c65579..674d793 100644
--- a/benchmarks/Makefile
+++ b/benchmarks/Makefile
@@ -3,9 +3,10 @@
 #-----------------------------------------------------------------------
 # Yunsup Lee (yunsup@cs.berkeley.edu)
 #
-
+XLEN = 32
 XLEN ?= 64
 
+ABI=ilp32
 ifeq ($(XLEN),32)
 ABI ?= ilp32d
 endif
@@ -32,13 +33,14 @@ base_bmarks = \
 	vvadd \
 	memcpy \
 	multiply \
-	mm \
-	dhrystone \
 	spmv \
+	dhrystone \
+	pmp\
+	#	mm \
 	mt-vvadd \
 	mt-matmul \
 	mt-memcpy \
-	pmp \
+
 
 vec_bmarks = \
 	vec-memcpy \
@@ -46,18 +48,20 @@ vec_bmarks = \
 	vec-sgemm \
 	vec-strcmp \
 
-bmarks = $(base_bmarks) $(vec_bmarks)
+bmarks = $(base_bmarks) #$(vec_bmarks)
 
 #--------------------------------------------------------------------
 # Build rules
 #--------------------------------------------------------------------
 
+RISCV_PREFIX ?= riscv64-unknown-elf-
 RISCV_PREFIX ?= riscv$(XLEN)-unknown-elf-
 RISCV_GCC ?= $(RISCV_PREFIX)gcc
-RISCV_GCC_OPTS ?= -U_FORTIFY_SOURCE -DPREALLOCATE=1 -mcmodel=medany -static -std=gnu99 -O2 -ffast-math -fno-common -fno-builtin-printf -fno-tree-loop-distribute-patterns -Wno-implicit-int -Wno-implicit-function-declaration -mabi=$(ABI)
+RISCV_GCC_OPTS ?= -U_FORTIFY_SOURCE -DPREALLOCATE=1 -specs=picolibc.specs -mcmodel=medany -static -std=gnu99 -O2 -ffast-math -fno-common -fno-builtin-printf -fno-tree-loop-distribute-patterns -Wno-implicit-int -Wno-implicit-function-declaration -mabi=$(ABI)
 RISCV_LINK ?= $(RISCV_GCC) -T $(src_dir)/common/test.ld $(incs)
 RISCV_LINK_OPTS ?= -static -nostdlib -nostartfiles -lm -lgcc -T $(src_dir)/common/test.ld
 RISCV_OBJDUMP ?= $(RISCV_PREFIX)objdump --disassemble-all --disassemble-zeroes --section=.text --section=.text.startup --section=.text.init --section=.data
+RISCV_MARCH ?= rv32i_zicsr
 RISCV_MARCH ?= rv$(XLEN)gc
 RISCV_VMARCH ?= rv$(XLEN)gcv
 RISCV_SIM ?= spike --isa=rv$(XLEN)gcv
diff --git a/benchmarks/common/crt.S b/benchmarks/common/crt.S
index 33e45ec..1fb198f 100644
--- a/benchmarks/common/crt.S
+++ b/benchmarks/common/crt.S
@@ -48,8 +48,8 @@ _start:
   li  x31,0
 
   # enable FPU, vector, and accelerator if present
-  li t0, MSTATUS_FS | MSTATUS_XS | MSTATUS_VS
-  csrs mstatus, t0
+  #li t0, MSTATUS_FS | MSTATUS_XS | MSTATUS_VS
+  #csrs mstatus, t0
 
   # make sure XLEN agrees with compilation choice
   li t0, 1
@@ -107,8 +107,8 @@ _start:
 #endif
 
   # initialize trap vector
-  la t0, trap_entry
