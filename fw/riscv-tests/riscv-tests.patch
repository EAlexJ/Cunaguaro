+  #csrw mtvec, t0
 
   # initialize global pointer
 .option push
@@ -121,7 +121,7 @@ _start:
   and tp, tp, -64
 
   # get core id
-  csrr a0, mhartid
+  #csrr a0, mhartid
   # for now, assume only 1 core
   li a1, 1
 1:bgeu a0, a1, 1b
@@ -172,15 +172,15 @@ trap_entry:
   SREG x30, 30*REGBYTES(sp)
   SREG x31, 31*REGBYTES(sp)
 
-  csrr a0, mcause
-  csrr a1, mepc
-  mv a2, sp
-  jal handle_trap
-  csrw mepc, a0
+  #csrr a0, mcause
+  #csrr a1, mepc
+  #mv a2, sp
+  #jal handle_trap
+  #csrw mepc, a0
 
   # Remain in M-mode after eret
   li t0, MSTATUS_MPP
-  csrs mstatus, t0
+  #csrs mstatus, t0
 
   LREG x1, 1*REGBYTES(sp)
   LREG x2, 2*REGBYTES(sp)
